'}}

def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--target", required=True)
    parser.add_argument("--report", required=True)
    args = parser.parse_args()
    target = Path(args.target).resolve()
    if not target.is_dir():
        raise SystemExit(f"target is not a directory: {target}")
    written = []
    for relative, spec in sorted(FILES.items()):
        raw = gzip.decompress(base64.b64decode(spec["gzip_b64"], validate=True))
        actual = hashlib.sha256(raw).hexdigest()
        if actual != spec["sha256"] or len(raw) != spec["bytes"]:
            raise SystemExit(f"embedded overlay identity mismatch: {relative}")
        destination = (target / relative).resolve()
        if target not in destination.parents:
            raise SystemExit(f"unsafe overlay path: {relative}")
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_bytes(raw)
        written.append({"path": relative, "sha256": actual, "bytes": len(raw)})
    # Validate decisive markers after writing, not just embedded bytes.
    checks = {
        "blender/procedural_jungle/generate_jungle_assets.py": ["procedural_jungle_manifest_v3", "DENSE_JUNGLE_VISUAL_ASSETS_GENERATED"],
        "unreal/procedural_jungle/build_unreal_scene.py": ["JUNGLE_VISUAL_OVERHAUL_V3", "SkyAtmosphere"],
        "scripts/procedural_jungle/build-procedural-jungle.ps1": ["PANDA_GENERATED_RIG_REUSE=PROVEN", "AUDIT_VISUAL_CAPTURE_QUALITY"],
        "scripts/procedural_jungle/audit_visual_captures.py": ["DENSE_JUNGLE_VISUAL_QUALITY_PROVEN"],
        "project_template/Source/ProceduralJungle58/JungleProofDirector.cpp": ["PrepareNextCapture", "panda_framed_capture_count"],
        "project_template/Source/ProceduralJungle58/PandaWalkerCharacter.cpp": ["bRunPhysicsWithNoController"],
        "project_template/Source/ProceduralJungle58/JunglePopulationActor.cpp": ["SceneRoot->SetMobility(EComponentMobility::Static)"],
    }
    for relative, markers in checks.items():
        text = (target / relative).read_text(encoding="utf-8")
        for marker in markers:
            if marker not in text:
                raise SystemExit(f"overlay marker missing: {relative}: {marker}")
    build_text = (target / "scripts/procedural_jungle/build-procedural-jungle.ps1").read_text(encoding="utf-8")
    if "RenderOffScreen" in build_text or "utf8NoBOM" in build_text:
        raise SystemExit("rejected runtime flag or unsupported encoding remains")
    report = {
        "classification": "PROVEN",
        "marker": MARKER,
        "file_count": len(written),
        "files": written,
    }
    report_path = Path(args.report)
    report_path.parent.mkdir(parents=True, exist_ok=True)
    report_path.write_text(json.dumps(report, indent=2, sort_keys=True), encoding="utf-8")
    print("JUNGLE_VISUAL_OVERHAUL_V3_INSTALLER=PROVEN", flush=True)
    print(json.dumps(report, sort_keys=True), flush=True)

if __name__ == "__main__":
    main()
