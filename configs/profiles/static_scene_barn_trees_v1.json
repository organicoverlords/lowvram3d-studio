    "REJECTED_HERO_CONTEXT_FUSION",
    "REJECTED_BACKGROUND_TEXTURE_CONTAMINATION",
    "REJECTED_EXPORT_STRUCTURE_PARITY"
  ],
  "executor_limits": {
    "preserve_active_baseline_run": true,
    "do_not_modify_pipeline_mid_run": true,
