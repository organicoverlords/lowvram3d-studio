    "meshes",
    "vertices",
    "triangles",
    "connected_components",
    "component_interpreted_boundary_edges",
    "component_interpreted_non_manifold_edges",
    "dimensions",
    "orientation",
    "material_slots",
    "texture_bindings",
    "uv_utilization",
    "true_uv_overlap",
    "uv_out_of_bounds_area",
    "source_view_silhouette_similarity",
    "observed_texture_coverage",
    "synthesized_texture_coverage",
    "thin_branch_survival",
    "barn_opening_preservation",
    "barn_tree_cross_contamination",
    "export_import_parity",
    "runtime",
    "peak_vram",
    "peak_ram",
    "file_size"
  ],
  "promotion_gates": {
