    "front",
    "rear",
    "left",
    "right",
    "top_threequarter",
    "barn_detail",
    "tree_silhouette_detail",
    "semantic_layers_overlay",
    "component_id_overlay",
    "texture_provenance_overlay",
    "lod_comparison"
  ],
  "required_metrics": [
