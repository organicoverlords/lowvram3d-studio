__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
envs/

# Local install state and per-machine artefacts
patch-backups/
install-state/
jobs/
*.log

# Generated 3D / texture artefacts (regenerate from the pipeline, do not version)
*.glb
*.fbx
*.npz
*.blend
*.blend1

# ...except the curated evidence set for the documented run.
!evidence/deliverable/*.glb

# Control tensors and other raw arrays. Regenerable from the mesh + camera set
# by workers/render_control_maps.py, and enormous: one 1024 control set is
# 150 MB for the tensor alone, and evidence/compare holds 804 MB of them.
*.npy

# Local agent tool state, not project state.
.opencode/
