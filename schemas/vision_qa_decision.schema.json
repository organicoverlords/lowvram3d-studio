{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vision_qa_decision_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model_id", "packet_id", "stage", "verdict", "confidence", "summary", "findings", "proposed_action", "uncertainties"],
  "properties": {
    "schema": {"const": "vision_qa_decision_v1"},
    "model_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["geometry", "uv", "texture", "rig", "export"]},
    "verdict": {"enum": ["pass", "retry", "quarantine", "user_review", "request_second_opinion"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "confidence", "evidence_ids", "detail"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "detail": {"type": "string"}
        }
      }
    },
    "proposed_action": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "parameters"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "parameters": {"type": "object"}
          }
        }
      ]
    },
    "uncertainties": {"type": "array", "items": {"type": "string"}}
  }
}
